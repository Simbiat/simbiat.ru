<tab-menu role="tablist">
    <a class="tab_name active" id="tab_name_view" href="#tab_name_view">View</a>
    <div class="tab_content active" id="tab_content_view">
        {% set post = post|merge({'no_user': false, 'noname': false, 'detailed_type': null, 'text_only': false, 'allow_reply_to': false, 'noeditedtime': false}) %}
        {{ include('common/elements/post.twig', post) }}
    </div>
    {% if not history_version %}
        {% if can_edit_post %}
            <a class="tab_name" id="tab_name_edit" href="#tab_name_edit">Edit</a>
            <div class="tab_content" id="tab_content_edit">
                {{ include('talks/forms/post.twig', {'verb': 'edit', 'new_thread': false, 'thread_id': thread_id, 'post_id': id, 'text': text, 'permissions': session_data.permissions, 'author': author, 'current_user': session_data.user_id}, with_context = false) }}
            </div>
        {% endif %}
        {% if history and 'view_posts_history' in session_data.permissions %}
            <a class="tab_name" id="tab_name_history" href="#tab_name_history">History</a>
            <div class="tab_content" id="tab_content_history">
                {% if history|length > 0 %}
                    <p>The list of versions below does not include any versions with the same text as the current one.</p>
                    <ol class="post_history" reversed>
                        {% for version, selected in history %}
                            <li>
                                <a href="/talks/posts/{{ post.id }}/{{ version }}" target="_blank">{{ timeTag(version, 'd/m/Y H:i') }}</a>
                            </li>
                        {% endfor %}
                    </ol>
                {% else %}
                    <p>There have been no edits to the text of this post.</p>
                {% endif %}
            </div>
        {% endif %}
        {% if 'move_posts' in session_data.permissions %}
            <a class="tab_name warning" id="tab_name_move" href="#tab_name_move">Move</a>
            <div class="tab_content" id="tab_content_move">
                <form id="post_move_form" name="post_move_form" autocomplete="off" class="middle">
                    <p>Input ID of the parent thread to which you want to move this post.</p>
                    <p class="warning">Note that moving this post
                        <b>can</b> affect content availability if new parent public and/or close status differ.</p>
                    <div class="float_label">
                        <input type="number" inputmode="decimal" min="1" value="{{ thread_id }}" step="1" aria-required="true" required name="post_data[thread_id]" id="cur_post_parent" placeholder="Parent ID">
                        <label for="cur_post_parent">Parent ID</label>
                    </div>
                    <br>
                    <input type="hidden" name="verb" value="move" required>
                    <input type="hidden" name="post_data[post_id]" value="{{ id }}" required>
                    <button type="submit" value="Move" id="post_move_submit" data-alt-attribute="Moving post...">
                        Move
                    </button>
                </form>
            </div>
        {% endif %}
        {% if 'remove_posts' in session_data.permissions %}
            <a class="tab_name danger" id="tab_name_delete" href="#tab_name_delete">Delete</a>
            <div class="tab_content" id="tab_content_delete">
                <form id="delete_post_form" name="delete_post_form" autocomplete="off">
                    <p>Pressing the below button will delete the current post completely.
                        <b class="warning">It will not be possible to restore it</b>, so do it after good and long thinking.
                    </p>
                    <p>If a post has attachments, they will not be removed along with the post. Instead, they will be removed during routine check for orphaned files if they are not linked to anything else.</p>
                    <p>If deletion is successful, you will be redirected to the respective parent thread.</p>
                    {% if author != session_data.user_id and author not in system_users %}
                        {{ include('common/elements/change_reason.twig', {'form_name': 'delete_post_form', 'array_name': 'post_data', 'placeholder': 'Deletion reason'}, with_context = false) }}
                    {% endif %}
                    <input type="hidden" name="verb" value="delete" required>
                    <input type="hidden" name="post_data[post_id]" value="{{ post.id }}" required>
                    <button type="submit" value="Delete" id="delete_post" data-alt-attribute="Deleting post...">
                        Delete
                    </button>
                </form>
            </div>
        {% endif %}
    {% endif %}
</tab-menu>