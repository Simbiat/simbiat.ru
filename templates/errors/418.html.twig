{% if reason == 'Teapot' %}
{% apply inline_css(source('@styles/email.css')) %}
<body>
    <header>
        {{ include('common/layout/header.twig') }}
    </header>
    <main id="content">
        <article id="http_error">
            <p>This website uses features aimed at improving the security of content delivery and information exchange.</p>
            <p>Unfortunately, these features are not supported by <b>{{ client }}</b> <i>teapot</i>.</p>
            <p>Since we value security, we are unable to serve any content to you.</p>
            <p>We are sorry for inconvenience, but, please, try with a different browser{% if teapot_browsers|length > 0 %}, for example:</p>
            <ul>
                {% for browser, version in teapot_browsers %}
                    <li>{{ browser }}, version {{ version }} and newer</li>
                {% endfor %}
            </ul>
            {% else %}.{% endif %}
        </article>
        <img crossorigin="anonymous" loading="lazy" decoding="async" alt="418 I'm a teapot" src="/assets/images/errors/teapot.avif" width="500" height="281">
        {% endapply %}
        {% else %}
            <blockquote class="w100pc" data-author="Server">I would not mind some tea myself, thank you for asking.</blockquote>
            <img crossorigin="anonymous" loading="lazy" decoding="async" alt="418 I'm a teapot" src="/assets/images/errors/teapot.avif" width="500" height="281">
        {% endif %}
        {% if reason == 'Teapot' %}
    </main>
</body>
{% endif %}