<password-field>
    <div class="float_label">
        <input type="password" spellcheck="false" required aria-required="true" name="{{ password_field_name }}" id="{{ password_field_id }}" placeholder="{{ password_field_placeholder }}" autocomplete="{% if new_password %}new-password{% else %}current_password{% endif %}" inputmode="text" minlength="8" pattern=".{8,}">
        <label for="{{ password_field_id }}">{{ password_field_placeholder }}</label>
        <div class="password_show"></div>
        {% if new_password %}
            <div class="password_requirements">Only password requirement: at least 8 symbols</div>
            <div class="password_strength">New password strength: <span>weak</span></div>
        {% endif %}
    </div>
</password-field>