<section>
    {% if not subservice_name %}
        <article class="margin_05rem">
            <details class="persistent" open>
                <summary class="right_summary about_section">About</summary>
                <p>HTML5 versions of games created by me, alone or with a small team.</p>
                {% if not subservice_name %}
                    <div class="about_showcase">
                        <a href="/games/jiangshi" class="about_banner no_new_tab_icon">
                            <img crossorigin="anonymous" loading="lazy" decoding="async" class="cursor_pointer" alt="" src="/assets/images/ogimages/jiangshi.webp" width="1200" height="630">
                            <div>Jiangshi</div>
                        </a>
                        <a href="/games/radicalresonance" class="about_banner no_new_tab_icon">
                            <img crossorigin="anonymous" loading="lazy" decoding="async" class="cursor_pointer" alt="" src="/assets/images/ogimages/RadicalResonance.png" width="1200" height="630">
                            <div>Radical Resonance</div>
                        </a>
                        <a href="/games/dden" class="about_banner no_new_tab_icon">
                            <img crossorigin="anonymous" loading="lazy" decoding="async" class="cursor_pointer" alt="" src="/assets/images/ogimages/dden.webp" width="1200" height="630">
                            <div>Dangerous Dave: Endless Nightmare</div>
                        </a>
                    </div>
                {% endif %}
            </details>
        </article>
    {% endif %}
    {% if subservice_name %}
        <article class="margin_05rem">
            {% if subservice_name == 'jiangshi' %}
                {{ include('games/jiangshi.twig') }}
            {% elseif subservice_name == 'dden' %}
                {{ include('games/dden.twig') }}
            {% elseif subservice_name == 'radicalresonance' %}
                {{ include('games/radicalresonance.twig') }}
            {% endif %}
        </article>
    {% endif %}
</section>
