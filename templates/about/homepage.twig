<div class="about_h_wrapper">
    <img crossorigin="anonymous" loading="lazy" decoding="async" class="nav_icon" alt="" data-tooltip="Track" src="/assets/images/navigation/projects.svg" width="800" height="800">
    <h2 id="track" class="home_page block_title">Check projects</h2>
</div>
<section>
    <div class="about_showcase">
        <a href="/fftracker" class="about_banner no_new_tab_icon">
            <img crossorigin="anonymous" loading="lazy" decoding="async" class="cursor_pointer" alt="" src="/assets/images/ogimages/fftracker.webp" width="1200" height="630">
            <div>Final Fantasy XIV Tracker</div>
        </a>
        <a href="/bictracker" class="about_banner no_new_tab_icon">
            <img crossorigin="anonymous" loading="lazy" decoding="async" class="cursor_pointer" alt="" src="/assets/images/ogimages/bictracker.webp" width="1200" height="630">
            <div>BIC Tracker</div>
        </a>
        <a href="/supops" class="about_banner no_new_tab_icon">
            <img crossorigin="anonymous" loading="lazy" decoding="async" class="cursor_pointer" alt="" src="/assets/images/supops/logo/ogimage.webp" width="1200" height="630">
            <div>SupOps</div>
        </a>
        <a href="/games/jiangshi" class="about_banner no_new_tab_icon">
            <img crossorigin="anonymous" loading="lazy" decoding="async" class="cursor_pointer" alt="" src="/assets/images/ogimages/jiangshi.webp" width="1200" height="630">
            <div>Jiangshi</div>
        </a>
        <a href="/games/radicalresonance" class="about_banner no_new_tab_icon">
            <img crossorigin="anonymous" loading="lazy" decoding="async" class="cursor_pointer" alt="" src="/assets/images/ogimages/RadicalResonance.png" width="1200" height="630">
            <div>Radical Resonance</div>
        </a>
        <a href="/games/dden" class="about_banner no_new_tab_icon">
            <img crossorigin="anonymous" loading="lazy" decoding="async" class="cursor_pointer" alt="" src="/assets/images/ogimages/dden.webp" width="1200" height="630">
            <div>Dangerous Dave: Endless Nightmare</div>
        </a>
    </div>
</section>

<div class="about_h_wrapper">
    <img crossorigin="anonymous" loading="lazy" decoding="async" class="nav_icon" alt="" data-tooltip="Read" src="/assets/images/navigation/talks.svg" width="48" height="48">
    <h2 id="read" class="home_page block_title">Read stuff</h2>
</div>
<div>
    {% for post in posts %}
        <article class="post has_banner no_user">
            <section class="post_header">
                {% if post.detailed_type == 'Changelog' and is_numeric(post.name) %}
                    <h3 class="post_name" id="{{ prettyURL(post.name) }}">
                        <a href="/talks/threads/{{ post.thread_id }}">{{ timeTag(post.name, 'Y.m.d') }}</a>
                    </h3>
                {% else %}
                    <h3 class="post_name" id="{{ prettyURL(post.name) }}">
                        <a href="/talks/threads/{{ post.thread_id }}" data-tooltip="{{ post.name }}">{{ post.name }}</a>
                    </h3>
                {% endif %}
            </section>
            {% if post.og_image %}
                <section class="post_banner">
                    <a href="/talks/threads/{{ post.thread_id }}" data-tooltip="{{ post.name }}">
                        <img crossorigin="anonymous" loading="lazy" decoding="async" alt="{{ post.name }}" src="{{ post.og_image.og_image }}" width="{{ post.og_image.og_image_width|default('') }}" height="{{ post.og_image.og_image_height|default('') }}">
                    </a>
                </section>
            {% endif %}
            <section class="post_text">
                {{ sanitize(post.text) }}
            </section>
            <section class="post_footer">
                <div class="post_time_id">
                    {{ timeTag(post.published, 'd/m/Y H:i', "post_time") }}
                </div>
            </section>
        </article>
    {% endfor %}
</div>