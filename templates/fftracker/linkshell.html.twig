<tab-menu role="tablist">
    <div role="tablist" class="tab_list">
        <a class="tab_name active" role="tab" id="tab_name_general" href="#tab_name_general" aria-controls="tab_content_general">General</a>
        {% if linkshell.past_members|length > 0 %}
            <a class="tab_name" role="tab" id="tab_name_past_members" href="#tab_name_past_members" aria-controls="tab_content_past_members">Past members</a>
        {% endif %}
    </div>
    <div id="tab_content_general" class="tab_content active" role="tabpanel" aria-labelledby="tab_name_general">
        <img crossorigin="anonymous" loading="lazy" decoding="async" class="float_left ff_crest" alt="{{ linkshell.name }}" src="/assets/images/fftracker/{% if linkshell.crossworld %}crossworld_{% endif %}linkshell.webp" width="64" height="64">
        <p>{% if linkshell.crossworld %}Crossworld {% endif %}Linkshell
            <b>"{{ linkshell.name }}"</b> was {% if linkshell.dates.formed %}formed on {{ timeTag(linkshell.dates.formed, 'd/m/Y') }} and {% endif %}registered on {{ timeTag(linkshell.dates.registered, 'd/m/Y') }} with ID
            <i>{{ linkshell.id }}</i>. Last set of interviews conducted on {% if linkshell.is_fresh %}<span class="success">{% endif %}{{ timeTag(linkshell.dates.updated, 'd/m/Y H:i') }}{% if linkshell.is_fresh %}</span>{% endif %}.{% if linkshell.dates.deleted %}
            <span class="failure">Was disbanded on {{ timeTag(linkshell.dates.deleted, 'd/m/Y') }}.</span>{% endif %}
        </p>
        <p>Operate{% if linkshell.dates.deleted %}d{% else %}s{% endif %} on
            <i>{{ linkshell.data_center ?? linkshell.server }}</i>.{% if not linkshell.dates.deleted %}{% if linkshell.community %} Has an open
                <a href="https://eu.finalfantasyxiv.com/lodestone/community_finder/{{ linkshell.community }}" target="_blank">community</a>.{% endif %}{% endif %}
        </p>
        {% if linkshell.old_names|length > 0 %}
            <p>Had also been known under
                <i>{{ linkshell.old_names|length }}</i> other name{% if linkshell.old_names|length > 1 %}s{% endif %}:
            </p>
            <ul>
                {% for name in linkshell.old_names %}
                    <li>{{ name }}</li>
                {% endfor %}
            </ul>
        {% endif %}
        {% if linkshell.members|length > 0 %}
            <p>Current members:</p>
            <ul class="search_results">
                {% for entity in linkshell.members %}
                    <li>{{ include('common/elements/entitycard.twig', entity) }}</li>
                {% endfor %}
            </ul>
        {% endif %}
        {% if linkshell.lodestone_url %}
            <p>See the record on
                <a href="{{ linkshell.lodestone_url }}" target="_blank">Lodestone</a>.</p>
        {% endif %}
        {% if not linkshell.dates.deleted and linkshell.dates.scheduled %}
            <p class="margin_top_1rem">
                Next interview scheduled for {{ timeTag(linkshell.dates.scheduled, 'd/m/Y H:i:s') }}.
            </p>
        {% endif %}
        {% if linkshell.can_refresh %}
            <p class="margin_top_1rem">
                <button class="refresh" id="ff_refresh" data-tooltip="Update {% if linkshell.crossworld %}crossworld {% endif %}linkshell" type="button" data-link="/api/fftracker/{% if linkshell.crossworld %}crossworld_{% endif %}linkshells/{{ linkshell.id }}/update">
                    <img crossorigin="anonymous" loading="lazy" decoding="async" alt="Update {% if linkshell.crossworld %}crossworld {% endif %}linkshell" src="/assets/images/refresh.svg" width="24" height="24">
                </button>
            </p>
        {% endif %}
    </div>
    {% if linkshell.past_members|length > 0 %}
        <div class="tab_content" id="tab_content_past_members" role="tabpanel" aria-labelledby="tab_name_past_members">
            <ul class="search_results">
                {% for entity in linkshell.past_members %}
                    <li>{{ include('common/elements/entitycard.twig', entity) }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
</tab-menu>