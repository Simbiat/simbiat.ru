{% if not path %}
    <section class="margin_bottom_2rem">
        <details class="persistent" open>
            <summary class="right_summary about_section">About crests' page</summary>
            <p>This page provides
                <a href="https://github.com/Simbiat/FFXIV-Crests-Components" target="_blank">components</a> used by FFXIV for creating crests: backgrounds, frames, emblems, – as well as "merged" crests, where all three were merged into one image (storage is temporary for these, acting as cache).
            </p>
            <p>These are not necessarily
                <b>all</b> components, let alone their combinations. Only those identified by the tracker service during its normal work are listed. Quite a few pre-merged crests can be downloaded
                <a href="https://github.com/Simbiat/FFXIV-Crests" target="_blank">here</a>.
            </p>
            <ul>
                <li>
                    <a href="/fftracker/crests/frame">{{ files.frame.name }}</a>: {{ files.frame.count }} icons
                </li>
                <li>
                    <a href="/fftracker/crests/emblem">{{ files.emblem.name }}</a>: {{ files.emblem.count }} folders
                </li>
                <li>
                    <a href="/fftracker/crests/background">{{ files.background.name }}</a>: {{ files.background.count }} folders
                </li>
                <li>
                    <a href="/fftracker/crests/merged">{{ files.merged.name }}</a>: {{ files.merged.count -3 }} folders
                </li>
            </ul>
        </details>
        <form id="ff_merge_crest" method="post">
            <p>You can merge crests components into one image, like what you can see in the folder with merged crests. Add names of the files that you want to merge into the fields below: they can be seen in the folders' listing. Only emblem is, technically, mandatory, the same as in-game, but use only it would make little sense.</p>
            <div class="middle">
                <span class="float_label">
                    <input id="crest_emblem" name="crest_emblem" type="text" inputmode="text" required pattern="^S[a-fA-F0-9]{2}_[a-fA-F0-9]{32}_[a-fA-F0-9]{2}_128x128\.png$">
                    <label for="crest_emblem">Emblem</label>
                </span>
                <span class="float_label">
                    <input id="crest_frame" name="crest_frame" type="text" inputmode="text" pattern="^F[a-fA-F0-9]{2}_[a-fA-F0-9]{32}_[a-fA-F0-9]{2}_128x128\.png$">
                    <label for="crest_frame">Frame</label>
                </span>
                <span class="float_label">
                    <input id="crest_background" name="crest_background" type="text" inputmode="text" pattern="^(B[a-fA-F0-9]{2}|F00)_[a-fA-F0-9]{32}_[a-fA-F0-9]{2}_128x128\.png$">
                    <label for="crest_background">Background</label>
                </span>
                <div id="crest_preview" data-tooltip="Crest preview">
                    <img crossorigin="anonymous" loading="lazy" decoding="async" src="" alt="Background" id="preview_background" width="128" height="128">
                    <img crossorigin="anonymous" loading="lazy" decoding="async" src="" alt="Frame" id="preview_frame" width="128" height="128">
                    <img crossorigin="anonymous" loading="lazy" decoding="async" src="" alt="Emblem" id="preview_emblem" width="128" height="128">
                </div>
                <button type="submit" value="Merge & Download" id="ff_merge_crest_submit" data-alt-attribute="Merging crest...">
                    Merge & Download
                </button>
            </div>
        </form>
    </section>
{% endif %}
{% if path %}
    <section>
        {% if files[path].parent %}
            <a class="middle block no_decor" href="{{ files[path].parent.href }}" data-tooltip="Parent folder">
                <img crossorigin="anonymous" loading="lazy" decoding="async" alt="Parent folder" src="/assets/images/navigation/folder_up.svg" class="link_icon" width="512" height="512">
                <span>{{ files[path].parent.name }}</span>
            </a>
        {% endif %}
        {% if files[path].files %}
            {{ include('common/elements/iconlist.twig', {icons: files[path].files}, with_context = false) }}
        {% else %}
            <ul>
                {% if files[path].name == 'Backgrounds' %}
                    {% set sub_directory_name = 'background' %}
                {% elseif files[path].name == 'Emblems' %}
                    {% set sub_directory_name = 'emblem' %}
                {% elseif files[path].name == 'Merged crests (cached)' %}
                    {% set sub_directory_name = 'merged' %}
                {% endif %}
                {% for dir in files[path].dirs %}
                    <li>
                        <a href="/fftracker/crests/{{ sub_directory_name }}/{{ dir.dirname }}">{{ dir.dirname }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        {% if files[path].parent %}
            <a class="middle block no_decor" href="{{ files[path].parent.href }}" data-tooltip="Parent folder">
                <img crossorigin="anonymous" loading="lazy" decoding="async" alt="Parent folder" src="/assets/images/navigation/folder_up.svg" class="link_icon" width="512" height="512">
                <span>{{ files[path].parent.name }}</span>
            </a>
        {% endif %}
    </section>
{% endif %}
