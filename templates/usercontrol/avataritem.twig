<li id="{{ avatar.file_id|default('hash') }}">
    <span class="float_label">
        <input id="avatar_{{ avatar.file_id|default('hash') }}" type="radio"{% if avatar|default(null) and avatar.current|default(null) %} checked{% endif %}>
        <label for="avatar_{{ avatar.file_id|default('hash') }}">
            <img crossorigin="anonymous" loading="lazy" decoding="async" alt="Avatar {{ number|default(null) }}" src="{{ avatar.url|default(null) }}" class="avatar">
        </label>
    </span>
    <button id="del_{{ avatar.file_id|default('hash') }}" type="button" class="delete_avatar{% if avatar|default(null) and avatar.current|default(null) %} hidden{% endif %}"{% if avatar|default(null) and avatar.current|default(null) %} disabled{% endif %}>
        <img crossorigin="anonymous" loading="lazy" decoding="async" alt="Delete avatar" src="/assets/images/close.svg">
    </button>
</li>
