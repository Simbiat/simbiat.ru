<table id="emails_list">
    <thead>
        <tr>
            <th>Email</th>
            <th>Confirmed</th>
            <th>Notifications</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        {% for number, email in emails %}
            {{ include('usercontrol/emailrow.twig', {'email': email, 'number': number, 'count_activated': count_activated, 'count_subscribed': count_subscribed}, with_context = false) }}
        {% endfor %}
    </tbody>
</table>
<form id="add_mail_form" name="add_mail_form" autocomplete="on" class="middle">
    <div class="float_label">
        <input type="email" spellcheck="false" aria-required="false" name="email" id="add_mail" placeholder="Email" autocomplete="email" inputmode="email" minlength="1" maxlength="254" pattern="^[\p{L}\d.!#$%&'*+\/=?^_`\{\|\}~\-]+@[a-zA-Z\d](?:[a-zA-Z\d\-]{0,61}[a-zA-Z\d])?(?:\.[a-zA-Z\d](?:[a-zA-Z\d\-]{0,61}[a-zA-Z\d])?)*$">
        <label for="add_mail">Email</label>
    </div>
    <button type="submit" name="add_mail[submit]" id="add_mail_submit" value="Add" data-alt-attribute="Adding email...">
        Add
    </button>
</form>
