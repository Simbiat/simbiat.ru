<tab-menu>
    <div role="tablist" class="tab_list">
        <a role="tab" class="tab_name{% if subservice_name == 'profile' %} active{% endif %}" href="/uc/profile">Profile</a>
        <a role="tab" class="tab_name{% if subservice_name == 'avatars' %} active{% endif %}" href="/uc/avatars">Avatars</a>
        <a role="tab" class="tab_name{% if subservice_name == 'fftracker' %} active{% endif %}" href="/uc/fftracker">FFXIV</a>
        <a role="tab" class="tab_name{% if subservice_name == 'emails' %} active{% endif %}" href="/uc/emails">Emails</a>
        <a role="tab" class="tab_name{% if subservice_name == 'password' %} active{% endif %}" href="/uc/password">Password</a>
        <a role="tab" class="tab_name{% if subservice_name == 'sessions' %} active{% endif %}" href="/uc/sessions">Sessions</a>
        <a role="tab" class="tab_name danger{% if subservice_name == 'removal' %} active{% endif %}" href="/uc/removal">Removal</a>
    </div>
</tab-menu>
<section>
    {% if subservice_name %}
        <article class="margin_05rem">
            {% if subservice_name == 'registration' %}
                {{ include('usercontrol/registration.html.twig') }}
            {% elseif subservice_name == 'activation' %}
                {{ include('usercontrol/activation.html.twig') }}
            {% elseif subservice_name == 'emails' %}
                {{ include('usercontrol/emails.html.twig') }}
            {% elseif subservice_name == 'unsubscribe' %}
                {{ include('usercontrol/unsubscribe.html.twig') }}
            {% elseif subservice_name == 'profile' %}
                {{ include('usercontrol/profile.html.twig') }}
            {% elseif subservice_name == 'password' %}
                {{ include('usercontrol/password.html.twig') }}
            {% elseif subservice_name == 'removal' %}
                {{ include('usercontrol/removal.html.twig') }}
            {% elseif subservice_name == 'avatars' %}
                {{ include('usercontrol/avatars.html.twig') }}
            {% elseif subservice_name == 'fftracker' %}
                {{ include('usercontrol/fftracker.html.twig') }}
            {% elseif subservice_name == 'sessions' %}
                {{ include('usercontrol/sessions.html.twig') }}
            {% endif %}
        </article>
    {% endif %}
</section>
