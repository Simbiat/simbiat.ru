{% if activated %}
    <p class="success">Mail {{ email }} confirmed{% if activation|default(null) %} and account activated{% endif %}.</p>
{% else %}
    <p class="error">Failed to confirm any emails.</p>
{% endif %}
{% if session_data.user_id != 1 and session_data.username %}
    <p>You can check the list of all your registered mails <a href="/uc/mails">here</a>.</p>
{% endif %}
