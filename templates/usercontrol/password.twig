<form id="password_change">
    {% if user_id and token %}
        <input type="hidden" required aria-required="true" name="pass_user_id" id="pass_user_id" value="{{ user_id }}">
        <input type="hidden" required aria-required="true" name="pass_reset" id="pass_reset" value="{{ token }}">
        <p>This is a password reset form. Set the new password below. If the password reset token is correct, the new password will be set for the respective user.</p>
    {% else %}
        {{ include('common/elements/password_field.twig', {'new_password': false, 'password_field_id': 'current_password', 'password_field_name': 'current_password', 'password_field_placeholder': 'Current password'}) }}
    {% endif %}
    {{ include('common/elements/password_field.twig', {'new_password': true, 'password_field_id': 'new_password', 'password_field_name': 'new_password', 'password_field_placeholder': 'New password'}) }}
    <button type="submit" name="password[submit]" id="password_submit" value="Change" data-alt-attribute="Changing password...">
        Change
    </button>
</form>
