<?xml version="1.0"?>
<!--TODO: May require extra setup for Symfony https://github.com/psalm/psalm-plugin-symfony-->
<psalm
    errorLevel="1"
    reportMixedIssues="true"
    addParamDefaultToDocblockType="true"
    checkForThrowsDocblock="true"
    checkForThrowsInGlobalScope="true"
    findUnusedVariablesAndParams="true"
    findUnusedCode="true"
    forceJit="true"
    findUnusedPsalmSuppress="true"
    ensureArrayStringOffsetsExist="true"
    ensureArrayIntOffsetsExist="true"
    cacheDirectory="data/cache/psalm"
    serializer="igbinary"
>
    <projectFiles>
        <directory name="./bin"/>
        <directory name="./lib"/>
        <directory name="./templates"/>
        <directory name="./tests"/>
        <ignoreFiles allowMissingFiles="true">
            <directory name="./lib/DDCIcons/src/icons"/>
            <directory name="./lib/FFXIV/CrestComponents"/>
            <directory name="./lib/FFXIV/EstateMaps"/>
            <directory name="./lib/FFXIV/Icons"/>
            <directory name="./lib/FFXIV/PSDs"/>
        </ignoreFiles>
    </projectFiles>
    <fileExtensions>
        <extension name=".php"/>
        <extension name=".twig" checker="./vendor/psalm/plugin-symfony/src/Twig/TemplateFileAnalyzer.php"/>
    </fileExtensions>
    <plugins>
        <pluginClass xmlns="https://getpsalm.org/schema/config" class="Psalm\PhpUnitPlugin\Plugin"/>
        <pluginClass xmlns="https://getpsalm.org/schema/config" class="Psalm\SymfonyPsalmPlugin\Plugin"/>
    </plugins>
</psalm>
