<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="vendor/autoload.php"
    backupGlobals="true"
    backupStaticAttributes="true"
    cacheDirectory="data/cache/phpunit"
    cacheResult="true"
    colors="true"
    requireCoverageMetadata="true"
    requireSealedMockObjects="true"
    processIsolation="true"
    stopOnDefect="true"
    stopOnError="true"
    stopOnFailure="true"
    stopOnWarning="false"
    stopOnRisky="true"
    stopOnDeprecation="false"
    stopOnNotice="false"
    stopOnSkipped="false"
    stopOnIncomplete="true"
    failOnAllIssues="true"
    failOnEmptyTestSuite="false"
    failOnDeprecation="true"
    failOnPhpunitDeprecation="true"
    failOnIncomplete="true"
    failOnRisky="true"
    beStrictAboutChangesToGlobalState="true"
    beStrictAboutOutputDuringTests="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
    beStrictAboutCoverageMetadata="true"
    executionOrder="depends,defects,duration"
    testdox="true"
    testdoxSummary="true"
    displayDetailsOnAllIssues="true"
    displayDetailsOnSkippedTests="false"
>
    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">lib</directory>
        </include>
    </source>
    <coverage
        includeUncoveredFiles="true"
        pathCoverage="true"
        ignoreDeprecatedCodeUnits="true"
        disableCodeCoverageIgnore="true"
    >
        <report>
            <clover outputFile="tests/coverage/clover.xml"/>
            <cobertura outputFile="tests/coverage/cobertura.xml"/>
            <crap4j outputFile="tests/coverage/crap4j.xml" threshold="50"/>
            <html outputDirectory="tests/coverage/html" lowUpperBound="50" highLowerBound="90"/>
            <php outputFile="tests/coverage/coverage.php"/>
            <text outputFile="tests/coverage/coverage.txt" showUncoveredFiles="false" showOnlySummary="true"/>
            <xml outputDirectory="tests/coverage/xml"/>
        </report>
    </coverage>
    <logging>
        <junit outputFile="tests/logs/junit.xml"/>
        <teamcity outputFile="tests/logs/teamcity.txt"/>
        <testdoxHtml outputFile="tests/logs/testdox.html"/>
        <testdoxText outputFile="tests/logs/testdox.txt"/>
    </logging>
</phpunit>