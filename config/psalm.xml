<?xml version="1.0"?>
<!--TODO: May require extra setup for Symfony https://github.com/psalm/psalm-plugin-symfony-->
<psalm
    autoloader="/app/vendor/autoload.php"
    errorLevel="1"
    reportMixedIssues="true"
    addParamDefaultToDocblockType="true"
    checkForThrowsDocblock="true"
    checkForThrowsInGlobalScope="true"
    findUnusedVariablesAndParams="true"
    findUnusedCode="true"
    forceJit="true"
    findUnusedPsalmSuppress="true"
    ensureArrayStringOffsetsExist="true"
    ensureArrayIntOffsetsExist="true"
    cacheDirectory="/tmp/psalm"
    serializer="igbinary"
>
    <projectFiles>
        <ignoreFiles allowMissingFiles="true">
            <directory name="/app/vendor"/>
        </ignoreFiles>
    </projectFiles>
    <fileExtensions>
        <extension name=".php"/>
        <extension name=".twig"
                   checker="../../../../composer/vendor/psalm/plugin-symfony/src/Twig/TemplateFileAnalyzer.php"/>
    </fileExtensions>
    <plugins>
        <pluginClass xmlns="https://getpsalm.org/schema/config" class="Psalm\PhpUnitPlugin\Plugin"/>
        <pluginClass xmlns="https://getpsalm.org/schema/config" class="Psalm\SymfonyPsalmPlugin\Plugin"/>
    </plugins>
</psalm>
