<?xml version="1.0"?>
<ruleset name="My first PHPMD rule set"
         xmlns="https://phpmd.org/xml/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://phpmd.org/xml/ruleset/1.0.0
                       https://phpmd.org/xml/ruleset_xml_schema_1.0.0.xsd"
         xsi:noNamespaceSchemaLocation="
                       https://phpmd.org/xml/ruleset_xml_schema_1.0.0.xsd">
    <description>
        Custom PHP MD ruleset
    </description>

    <exclude-pattern>/app/assets/*</exclude-pattern>
    <exclude-pattern>/app/bin/console</exclude-pattern>
    <exclude-pattern>/app/bin/phpunit</exclude-pattern>
    <exclude-pattern>/app/build/*</exclude-pattern>
    <exclude-pattern>/app/config/bundles.php</exclude-pattern>
    <exclude-pattern>/app/config/preload.php</exclude-pattern>
    <exclude-pattern>/app/config/reference.php</exclude-pattern>
    <exclude-pattern>/app/data/*</exclude-pattern>
    <exclude-pattern>/app/node_modules/*</exclude-pattern>
    <exclude-pattern>/app/packages/DDCIcons/icons/*</exclude-pattern>
    <exclude-pattern>/app/public/*</exclude-pattern>
    <exclude-pattern>/app/var/*</exclude-pattern>
    <exclude-pattern>/app/vendor/*</exclude-pattern>

    <rule ref="rulesets/cleancode.xml"/>
    <rule ref="rulesets/codesize.xml"/>
    <rule ref="rulesets/controversial.xml"/>
    <rule ref="rulesets/design.xml"/>
    <rule ref="rulesets/naming.xml"/>
    <rule ref="rulesets/unusedcode.xml"/>
</ruleset>
