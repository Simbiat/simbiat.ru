<?xml version="1.0"?>
<psalm
    autoloader="/app/vendor/autoload.php"
    errorLevel="1"
    reportMixedIssues="true"
    addParamDefaultToDocblockType="true"
    checkForThrowsDocblock="true"
    checkForThrowsInGlobalScope="true"
    findUnusedVariablesAndParams="true"
    findUnusedCode="true"
    forceJit="true"
    reportInfo="true"
    findUnusedPsalmSuppress="true"
    ensureArrayStringOffsetsExist="true"
    ensureArrayIntOffsetsExist="true"
    cacheDirectory="/app/data/temp/psalm"
    serializer="igbinary"
    allowStringToStandInForClass="true"
>
    <projectFiles>
        <directory name="/app"/>
        <ignoreFiles allowMissingFiles="true">
            <directory name="/app/assets"/>
            <directory name="/app/build"/>
            <file name="/app/bin/console"/>
            <file name="/app/bin/phpunit"/>
            <directory name="/app/data"/>
            <file name="/app/config/bundles.php"/>
            <file name="/app/config/preload.php"/>
            <file name="/app/config/reference.php"/>
            <directory name="/app/node_modules"/>
            <directory name="/app/packages/DDCIcons/icons"/>
            <directory name="/app/public"/>
            <directory name="/app/var"/>
            <directory name="/app/vendor"/>
        </ignoreFiles>
    </projectFiles>
    <fileExtensions>
        <extension name=".php"/>
        <extension name=".twig"
                   checker="../../vendor/psalm/plugin-symfony/src/Twig/TemplateFileAnalyzer.php"/>
    </fileExtensions>
    <plugins>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin"/>
        <pluginClass class="Psalm\SymfonyPsalmPlugin\Plugin">
            <!-- #TODO: uncomment when moving to APP_DEBUG issue is resolved
                <containerXml>/app/var/cache/dev/App_KernelDevDebugContainer.xml</containerXml>
            -->
        </pluginClass>
    </plugins>
    <!-- #TODO: uncomment when moving to PHP configs
    <extraFiles>
        <directory name="/app/var/cache/dev/Symfony/Config" />
    </extraFiles>
    <stubs>
        <file name="/app/vendor/symfony/dependency-injection/Loader/Configurator/ContainerConfigurator.php" />
    </stubs>
    -->
</psalm>
