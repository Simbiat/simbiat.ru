# Runs every minute
* * * * * /etc/supercronic/bin/cron-php.sh app:health:db
* * * * * /etc/supercronic/bin/cron-php.sh app:clean:sessions
* * * * * /etc/supercronic/bin/cron-php.sh app:clean:cookies
* * * * * /etc/supercronic/bin/cron-php.sh app:mailer
#This has to use a 7-elements format to properly run every 20 seconds. PHPStorm's plugin does not like the format, though.
*/20 * * * * * * /etc/supercronic/bin/cron-php.sh app:cron

# Healthchecks
*/10 * * * * /etc/supercronic/bin/health-space.sh
* * * * * /etc/supercronic/bin/health-php-log.sh

# Daily PHP tasks. Time staggering is mostly superficial, since there are no strict dependencies between the jobs.
5 0 * * * /etc/supercronic/bin/cron-php.sh app:clean:logs
10 0 * * * /etc/supercronic/bin/cron-php.sh app:clean:statistics
15 0 * * * /etc/supercronic/bin/cron-php.sh app:clean:foreign_keys
20 0 * * * /etc/supercronic/bin/cron-php.sh app:clean:uploads
25 0 * * * /etc/supercronic/bin/cron-php.sh app:clean:notifications
30 0 * * * /etc/supercronic/bin/cron-php.sh app:talks:clean_avatars
35 0 * * * /etc/supercronic/bin/cron-php.sh app:talks:lock_posts
40 0 * * * /etc/supercronic/bin/cron-php.sh app:talks:close_tickets
45 0 * * * /etc/supercronic/bin/cron-php.sh app:talks:empty_threads
30 0 * * * /etc/supercronic/bin/cron-php.sh app:bic:update
0 1 * * * /etc/supercronic/bin/cron-php.sh app:ffxiv:servers
10 1 * * * /etc/supercronic/bin/cron-php.sh app:ffxiv:statistics
40 1 * * * /etc/supercronic/bin/cron-php.sh app:ffxiv:characters
0 2 * * * /etc/supercronic/bin/cron-php.sh app:db:order
30 2 * * * /etc/supercronic/bin/cron-php.sh app:db:optimize
0 2 * * * /etc/supercronic/bin/cron-php.sh app:sitemap
# This one is not ready yet
#0 0 * * * /etc/supercronic/bin/cron-php.sh app:clean:dead_links

# Daily non-PHP tasks
0 3 * * * /etc/supercronic/bin/cron-wrapper.sh mariadb /etc/mysql/cron/mariadb-backup.sh
0 0 * * * /etc/supercronic/bin/cron-wrapper.sh geoip /usr/bin/geoipupdate --output
30 1 * * * /etc/supercronic/bin/clean-files.sh

# Rotate logs
0 0 * * * /etc/supercronic/bin/log-rotate.sh

# Supercronic's hearbeat
* * * * * touch /tmp/heartbeat
