<?xml version="1.0"?>
<!-- TODO: Monitor discussion about PER ruleset https://github.com/PHPCSStandards/PHP_CodeSniffer/issues/29 -->
<ruleset name="Application" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="/vendor/squizlabs/php_codesniffer/phpcs.xsd">

    <description>
        PHPCS configuration for Symfony application.
    </description>

    <!-- Directories to scan -->
    <file>/app/src</file>
    <file>/app/tests</file>
    <file>/app/packages</file>
    <file>/app/bin</file>
    <file>/app/config</file>
    <file>/app/public</file>
    <arg name="extensions" value="php"/>
    <!-- Exclusions -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>var/*</exclude-pattern>

    <!-- Performance -->
    <arg name="cache" value="/tmp/phpcs.cache"/>
    <arg value="p"/>

    <!-- Reporting -->
    <arg name="colors"/>
    <arg name="parallel" value="8"/>

    <!-- Base standards -->
    <rule ref="PSR12">
        <exclude name="PSR12.Operators.OperatorSpacing"/>
    </rule>
    <rule ref="PSR2.ControlStructures.ControlStructureSpacing">
        <!-- Prohibits multiline conditions, allowed by PSR12 -->
        <exclude name="PSR2.ControlStructures.ControlStructureSpacing"/>
    </rule>

    <!-- Symfony coding standard -->
    <rule ref="Symfony"/>
    <rule ref="Symfony.Commenting.License.Warning">
        <exclude name="Symfony.Commenting.License.Warning"/>
        <exclude name="Symfony.ControlStructure.YodaConditions"/>
    </rule>

    <!-- PHP compatibility -->
    <rule ref="PHPCompatibility"/>
    <config name="testVersion" value="8.5-"/>

    <!-- Slevomat quality rules -->
    <rule ref="SlevomatCodingStandard"/>

    <!-- Useful modern strictness -->

    <rule ref="Generic.PHP.DisallowShortOpenTag"/>
    <rule ref="Generic.CodeAnalysis.EmptyStatement"/>
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter"/>

    <rule ref="Squiz.PHP.CommentedOutCode"/>

    <!-- Symfony projects typically use attributes -->
    <rule ref="SlevomatCodingStandard.Attributes"/>
    <rule ref="SlevomatCodingStandard.Attributes.AttributesOrder">
        <properties>
            <property name="orderAlphabetically" value="true"/>
        </properties>
    </rule>

    <!-- Type declarations -->
    <rule ref="SlevomatCodingStandard.TypeHints">
        <!-- Conflicts Symfony.Commenting.FunctionComment.MissingReturn -->
        <exclude name="SlevomatCodingStandard.TypeHints.ReturnTypeHint.UselessAnnotation"/>
        <exclude name="SlevomatCodingStandard.TypeHints.ParameterTypeHint.UselessAnnotation"/>
        <!-- This sniff has been deprecated since Slevomat Coding Standard 8.16.0 and will be removed in Slevomat Coding Standard 9.0.0. Use SlevomatCodingStandard.TypeHints.DNFTypeHintFormat instead -->
        <exclude name="SlevomatCodingStandard.TypeHints.UnionTypeHintFormat"/>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.DeclareStrictTypes">
        <properties>
            <property name="spacesCountAroundEqualsSign" value="0"/>
        </properties>
    </rule>

    <!-- Namespaces -->
    <rule ref="SlevomatCodingStandard.Namespaces"/>
    <rule ref="SlevomatCodingStandard.Namespaces.ReferenceUsedNamesOnly">
        <properties>
            <property name="allowFullyQualifiedGlobalClasses" value="true"/>
            <property name="allowFullyQualifiedGlobalFunctions" value="true"/>
            <property name="allowFullyQualifiedGlobalConstants" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Namespaces.UseOnlyWhitelistedNamespaces.NonFullyQualified">
        <exclude name="SlevomatCodingStandard.Namespaces.UseOnlyWhitelistedNamespaces.NonFullyQualified"/>
    </rule>

    <!-- Classes -->
    <rule ref="SlevomatCodingStandard.Classes">
        <exclude name="SlevomatCodingStandard.Classes.EmptyLinesAroundClassBraces.NoEmptyLineAfterOpeningBrace"/>
        <exclude name="SlevomatCodingStandard.Classes.EmptyLinesAroundClassBraces.NoEmptyLineBeforeClosingBrace"/>
        <exclude name="SlevomatCodingStandard.Classes.ClassLength.ClassTooLong"/>
        <!-- Contradicts Symfony coding standards -->
        <exclude name="SlevomatCodingStandard.Classes.RequireMultiLineMethodSignature"/>
    </rule>

    <!-- Functions -->
    <rule ref="SlevomatCodingStandard.Functions">
        <exclude name="SlevomatCodingStandard.Functions.DisallowNamedArguments.DisallowedNamedArgument"/>
        <exclude name="SlevomatCodingStandard.Functions.FunctionLength.FunctionLength"/>
        <!-- Conflicts with SlevomatCodingStandard.Functions.RequireTrailingCommaInCall -->
        <exclude name="SlevomatCodingStandard.Functions.DisallowTrailingCommaInCall"/>
        <!-- Contradicts Symfony coding standards -->
        <exclude name="SlevomatCodingStandard.Functions.RequireMultiLineCall"/>
        <exclude name="SlevomatCodingStandard.Functions.DisallowArrowFunction"/>
    </rule>
    <rule ref="SlevomatCodingStandard.Functions.ArrowFunctionDeclaration">
        <properties>
            <property name="spacesCountAfterKeyword" value="0"/>
        </properties>
    </rule>

    <!-- Control structures -->
    <rule ref="SlevomatCodingStandard.ControlStructures">
        <exclude name="SlevomatCodingStandard.ControlStructures.BlockControlStructureSpacing"/>
        <exclude name="SlevomatCodingStandard.ControlStructures.NewWithoutParentheses.UselessParentheses"/>
        <exclude name="SlevomatCodingStandard.Exceptions.DisallowNonCapturingCatch.DisallowedNonCapturingCatch"/>
        <!-- Conflicts SlevomatCodingStandard.ControlStructures.DisallowYodaComparison -->
        <exclude name="SlevomatCodingStandard.ControlStructures.RequireYodaComparison.RequiredYodaComparison"/>
        <!-- Conflicts SlevomatCodingStandard.ControlStructures.RequireMultiLineCondition -->
        <exclude name="SlevomatCodingStandard.ControlStructures.RequireSingleLineCondition"/>
    </rule>
    <rule ref="SlevomatCodingStandard.ControlStructures.EarlyExit">
        <properties>
            <property name="ignoreStandaloneIfInScope" value="true"/>
            <property name="ignoreOneLineTrailingIf" value="true"/>
            <property name="ignoreTrailingIfWithOneInstruction" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.ControlStructures.RequireMultiLineCondition">
        <properties>
            <property name="minLineLength" value="0"/>
            <property name="booleanOperatorOnPreviousLine" value="false"/>
            <property name="alwaysSplitAllConditionParts" value="true"/>
        </properties>
    </rule>

    <!-- Variables -->
    <rule ref="SlevomatCodingStandard.Variables"/>

    <!-- Arrays -->
    <rule ref="SlevomatCodingStandard.Arrays"/>

    <!-- Operators -->
    <rule ref="SlevomatCodingStandard.Operators">
        <exclude name="SlevomatCodingStandard.Operators.DisallowIncrementAndDecrementOperators"/>
    </rule>

    <!-- Complexity -->
    <rule ref="SlevomatCodingStandard.Complexity">
        <exclude name="SlevomatCodingStandard.Complexity.Cognitive.ComplexityTooHigh"/>
    </rule>

    <!-- Exceptions -->
    <rule ref="SlevomatCodingStandard.Exceptions"/>

    <rule ref="SlevomatCodingStandard.Numbers">
        <!-- Conflicts SlevomatCodingStandard.Numbers.RequireNumericLiteralSeparator -->
        <exclude name="SlevomatCodingStandard.Numbers.DisallowNumericLiteralSeparator"/>
    </rule>

    <!-- Include PHPCSExtra rulesets -->
    <rule ref="NormalizedArrays"/>
    <rule ref="Modernize"/>
    <rule ref="Universal">
        <exclude name="Universal.UseStatements.DisallowUseClass.FoundWithoutAlias"/>
        <exclude name="Universal.Classes.DisallowFinalClass.FinalClassFound"/>
        <exclude name="Universal.Namespaces.EnforceCurlyBraceSyntax.Forbidden"/>
        <exclude name="Universal.UseStatements.DisallowUseClass.FoundWithAlias"/>
        <exclude name="Universal.ControlStructures.IfElseDeclaration.NoNewLine"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax.Found"/>
        <!-- Conflicts Universal.PHP.DisallowExitDieParentheses -->
        <exclude name="Universal.PHP.RequireExitDieParentheses"/>
        <!-- Duplicates SlevomatCodingStandard.Classes.RequireAbstractOrFinal -->
        <exclude name="Universal.Classes.RequireFinalClass"/>
    </rule>

    <rule ref="Zend">
        <!-- Conflicts with project's conventions -->
        <exclude name="Zend.NamingConventions.ValidVariableName.NotCamelCaps"/>
        <exclude name="Zend.NamingConventions.ValidVariableName.MemberVarNotCamelCaps"/>
    </rule>

    <rule ref="Generic.Files.LineLength.MaxExceeded">
        <exclude name="Generic.Files.LineLength.MaxExceeded"/>
    </rule>
    <rule ref="Generic.Files.LineLength.TooLong">
        <exclude name="Generic.Files.LineLength.TooLong"/>
    </rule>
    <rule ref="SlevomatCodingStandard.Files.TypeNameMatchesFileName">
        <properties>
            <property name="rootNamespaces" type="array">
                <element key="src" value="App"/>
                <element key="packages/Argon" value="Simbiat"/>
                <element key="packages/ArrayHelpers" value="Simbiat\ArrayHelpers"/>
                <element key="packages/BIC/AccountKeying" value="Simbiat\BIC"/>
                <element key="packages/Cron" value="Simbiat\Cron"/>
                <element key="packages/CuteBytes" value="Simbiat"/>
                <element key="packages/Database/Bind " value="Simbiat\Database"/>
                <element key="packages/Database/Installer" value="Simbiat\Database"/>
                <element key="packages/Database/Maintainer" value="Simbiat\Database\Maintainer"/>
                <element key="packages/Database/Manage" value="Simbiat\Database"/>
                <element key="packages/Database/Pool" value="Simbiat\Database"/>
                <element key="packages/Database/Query" value="Simbiat\Database"/>
                <element key="packages/DDCIcons" value="Simbiat"/>
                <element key="packages/FFXIV/Lodestone" value="Simbiat\FFXIV"/>
                <element key="packages/HTML/Cut" value="Simbiat\HTML"/>
                <element key="packages/HTML/nl2tag" value="Simbiat\HTML"/>
                <element key="packages/HTMLCache" value="Simbiat"/>
                <element key="packages/HTTP/SSE" value="Simbiat\HTTP"/>
                <element key="packages/http20" value="Simbiat\htt20"/>
                <element key="packages/SandClock" value="Simbiat"/>
                <element key="packages/Sniffs" value=""/>
                <element key="packages/StringHelpers" value="Simbiat\StringHelpers"/>
            </property>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Files.LineLength.LineTooLong">
        <exclude name="SlevomatCodingStandard.Files.LineLength.LineTooLong"/>
    </rule>
    <rule ref="SlevomatCodingStandard.Files.FileLength.FileTooLong">
        <exclude name="SlevomatCodingStandard.Files.FileLength.FileTooLong"/>
    </rule>
    <rule ref="SlevomatCodingStandard.Commenting.DocCommentSpacing">
        <properties>
            <property name="linesCountBetweenDescriptionAndAnnotations" value="1"/>
            <property name="linesCountBetweenDifferentAnnotationsTypes" value="1"/>
        </properties>
    </rule>
    <!-- PHPDoc is usually much cleaner than assert() -->
    <rule ref="SlevomatCodingStandard.PHP.RequireExplicitAssertion.RequiredExplicitAssertion">
        <exclude name="SlevomatCodingStandard.PHP.RequireExplicitAssertion.RequiredExplicitAssertion"/>
    </rule>
    <rule ref="SlevomatCodingStandard.Whitespaces.DuplicateSpaces">
        <properties>
            <property name="ignoreSpacesInAnnotation" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.PHP.UselessParentheses">
        <properties>
            <property name="enableCheckAroundNew" value="true"/>
        </properties>
    </rule>

    <rule ref="Generic.WhiteSpace.DisallowTabIndent"/>
    <config name='tab-width' value='4'/>
    <rule ref="Generic.WhiteSpace.ScopeIndent">
        <properties>
            <property name="indent" value="4"/>
        </properties>
    </rule>
    <rule ref="Universal.WhiteSpace.DisallowInlineTabs"/>

    <!-- My own sniffs -->
    <rule ref="/app/packages/Sniffs/Simbiat/ruleset.xml"/>
    <rule ref="Simbiat">
        <exclude-pattern phpcbf-only="true">/app/packages/Sniffs/tests/*</exclude-pattern>
    </rule>
    <rule ref="Simbiat.SQL.DateTimeFunctions">
        <properties>
            <property name="precision" value="6"/>
        </properties>
    </rule>
</ruleset>
