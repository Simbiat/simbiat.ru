// Force HTTPS
{
    "match": [
        {
            "protocol": "http"
        }
    ],
    "handle": [
        {
            "handler": "static_response",
            "headers": {
                "Location": [
                    "https://{http.request.host}{http.request.uri}"
                ],
                "X-Redirect-Source": [
                    "Caddy"
                ]
            },
            "status_code": 308,
            "close": true
        }
    ]
}