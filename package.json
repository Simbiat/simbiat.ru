{
    "name": "simbiat.eu",
    "version": "1.0.0",
    "description": "simbiat.eu NPM packages used in development",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/simbiat/simbiat.ru.git"
    },
    "license": "AGPL-3.0-or-later",
    "author": {
        "name": "Dmitrii Kustov",
        "email": "upport@simbiat.eu",
        "url": "https://www.simbiat.eu"
    },
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": "./public/assets/app.js"
    },
    "files": [],
    "scripts": {
        "bundle": "bun ./build/js/dev/Prepare.mts",
        "eslint": "eslint -c ./config/eslint.config.mts --no-config-lookup --color --report-unused-disable-directives-severity warn --report-unused-inline-configs warn --cache --cache-location ./data/temp/.eslintcache --cache-strategy content --concurrency auto",
        "generate:caddy": "bun ./build/js/dev/GenerateCaddyConfig.mts",
        "generate:config": "bun ./build/js/dev/GenerateSharedConfig.mts",
        "generate:css": "bun ./build/js/dev/GenerateCSS.mts",
        "generate:mime": "bun ./build/js/dev/GenerateMIMEFiles.mts",
        "prepare": "bun generate:mime && bun generate:config && bun bundle",
        "stylelint": "stylelint -c ./config/stylelint.config.ts --color --cache --cache-location ./data/temp/.stylelintcache --cache-strategy content --report-descriptionless-disables --report-invalid-scope-disables --report-needless-disables --report-unscoped-disables"
    },
    "browserslist": [
        "fully supports es6-module and supports custom-elementsv1 and fully supports css-nesting and fully supports css-has and supports trusted-types"
    ],
    "devDependencies": {
        "@eslint/eslintrc": "*",
        "@eslint/js": "*",
        "@eslint/json": "*",
        "@eslint/markdown": "*",
        "@html-eslint/eslint-plugin": "*",
        "@html-eslint/parser": "*",
        "@simbiat/eslint-plugin-simbiat": "file:./build/js/dev/ESLintPlugin",
        "@simbiat/stylelint-plugin-simbiat": "file:./build/js/dev/StylelintPlugin",
        "@stylistic/eslint-plugin": "*",
        "@types/bun": "*",
        "@types/eslint-plugin-github": "*",
        "@types/eslint-plugin-no-constructor-bind": "*",
        "@types/eslint-plugin-no-unsanitized": "*",
        "@types/eslint-plugin-promise": "*",
        "@types/eslint-plugin-security": "*",
        "@types/eslint-plugin-xss": "*",
        "@types/mime-db": "*",
        "@types/postcss-import": "*",
        "@types/semver": "*",
        "@types/trusted-types": "*",
        "@typescript-eslint/parser": "*",
        "browserslist": "*",
        "caniuse-lite": "*",
        "cssnano": "*",
        "dompurify": "*",
        "eslint": "*",
        "eslint-plugin-compat": "*",
        "eslint-plugin-de-morgan": "*",
        "eslint-plugin-escompat": "*",
        "eslint-plugin-eslint-comments": "*",
        "eslint-plugin-exception-handling": "*",
        "eslint-plugin-filenames": "*",
        "eslint-plugin-github": "*",
        "eslint-plugin-i18n-text": "*",
        "eslint-plugin-import": "*",
        "eslint-plugin-import-next": "*",
        "eslint-plugin-jsdoc": "*",
        "eslint-plugin-jsx-a11y": "*",
        "eslint-plugin-no-constructor-bind": "*",
        "eslint-plugin-no-only-tests": "*",
        "eslint-plugin-no-unsanitized": "*",
        "eslint-plugin-package-json": "*",
        "eslint-plugin-pii": "*",
        "eslint-plugin-prettier": "*",
        "eslint-plugin-promise": "*",
        "eslint-plugin-redos": "*",
        "eslint-plugin-regexp": "*",
        "eslint-plugin-security": "*",
        "eslint-plugin-sonarjs": "*",
        "eslint-plugin-unicorn": "*",
        "eslint-plugin-xss": "*",
        "globals": "*",
        "jiti": "*",
        "mime-db": "*",
        "postcss": "*",
        "postcss-import": "*",
        "postcss-preset-env": "*",
        "postcss-selector-parser": "*",
        "semver": "*",
        "stylelint": "*",
        "stylelint-config-standard": "*",
        "stylelint-declaration-block-no-ignored-properties": "*",
        "stylelint-high-performance-animation": "*",
        "stylelint-no-browser-hacks": "*",
        "stylelint-no-unsupported-browser-features": "*",
        "stylelint-order": "*",
        "stylelint-plugin-logical-css": "*",
        "stylelint-use-nesting": "*",
        "tinymce": "file:./vendor/tinymce/tinymce",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "*",
        "update-browserslist-db": "*"
    }
}
