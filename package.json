        "eslint-plugin-de-morgan": "^2.1.3",
        "eslint-plugin-escompat": "^3.11.4",
        "eslint-plugin-eslint-comments": "^3.2.0",
        "eslint-plugin-exception-handling": "^1.8.0",
        "eslint-plugin-filenames": "^1.3.2",
        "eslint-plugin-github": "^6.1.1",
        "eslint-plugin-i18n-text": "^1.0.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-import-next": "^2.3.8",
        "eslint-plugin-jsdoc": "^63.3.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-no-constructor-bind": "^2.0.4",
        "eslint-plugin-no-only-tests": "^3.4.0",
        "eslint-plugin-no-unsanitized": "^4.1.5",
        "eslint-plugin-package-json": "^1.6.2",
        "eslint-plugin-pii": "^1.0.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-redos": "^4.5.0",
        "eslint-plugin-regexp": "^3.1.1",
        "eslint-plugin-security": "^4.0.1",
        "eslint-plugin-sonarjs": "^4.2.0",
        "eslint-plugin-unicorn": "^72.0.0",
        "eslint-plugin-xss": "^0.1.12",
        "globals": "^17.7.0",
        "jiti": "^2.7.0",
        "mime-db": "^1.54.0",
        "postcss": "^8.5.23",
        "postcss-import": "^16.1.1",
        "postcss-preset-env": "^11.3.2",
        "postcss-selector-parser": "^7.1.4",
        "semver": "^7.8.5",
        "stylelint": "^17.14.1",
