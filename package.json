{
    "name": "simbiat.eu",
    "version": "1.0.0",
    "description": "simbiat.eu NPM packages used in development",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/simbiat/simbiat.ru.git"
    },
    "license": "AGPL-3.0-or-later",
    "author": {
        "name": "Dmitrii Kustov",
        "email": "upport@simbiat.eu",
        "url": "https://www.simbiat.eu"
    },
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": "./public/assets/app.js"
    },
    "files": [],
    "scripts": {
        "eslint": "eslint -c ./config/eslint.config.mts --no-config-lookup --color --report-unused-disable-directives-severity warn --report-unused-inline-configs warn --cache --cache-location ./config/.eslintcache --cache-strategy content --concurrency auto",
        "generate:caddy": "bun ./build/js/dev/GenerateCaddyConfig.mts",
        "generate:config": "bun ./build/js/dev/GenerateSharedConfig.mts",
        "generate:css": "bun ./build/js/dev/GenerateCSS.mts",
        "generate:mime": "bun ./build/js/dev/GenerateMIMEFiles.mts",
        "prepare": "bun generate:mime && bun generate:config && bun ./build/js/dev/Prepare.mts",
        "stylelint": "stylelint -c ./config/stylelint.config.ts --color --cache --cache-location ./config/.stylelintcache --cache-strategy content --report-descriptionless-disables --report-invalid-scope-disables --report-needless-disables --report-unscoped-disables"
    },
    "browserslist": [
        "fully supports es6-module and supports custom-elementsv1 and fully supports css-nesting and fully supports css-has and supports trusted-types"
    ],
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.0.1",
        "@eslint/markdown": "^8.0.3",
        "@html-eslint/eslint-plugin": "^0.64.0",
        "@html-eslint/parser": "^0.64.0",
        "@simbiat/eslint-plugin-simbiat": "file:./build/js/dev/ESLintPlugin",
        "@simbiat/stylelint-plugin-simbiat": "file:./build/js/dev/StylelintPlugin",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/bun": "^1.3.14",
        "@types/eslint-plugin-github": "^6.0.0",
        "@types/eslint-plugin-no-constructor-bind": "^2.0.0",
        "@types/eslint-plugin-no-unsanitized": "^4.1.0",
        "@types/eslint-plugin-promise": "^7.3.0",
        "@types/eslint-plugin-security": "^3.0.1",
        "@types/eslint-plugin-xss": "^0.1.0",
        "@types/mime-db": "^1.43.6",
        "@types/postcss-import": "^14.0.3",
        "@types/semver": "^7.7.1",
        "@types/trusted-types": "^2.0.7",
        "@typescript-eslint/parser": "^8.65.0",
        "browserslist": "^4.28.7",
        "caniuse-lite": "^1.0.30001806",
        "cssnano": "^8.0.2",
        "dompurify": "^3.4.12",
        "eslint": "^10.8.0",
