/**
 * Originally generated by ChatGPT but manually reviewed, adjusted, and tested.
 * @file Prevent count of timers, when page is not active or not visible.
 */

type TimerCallback = () => void;

/**
 * `active` means the timer is counting only when the window is visible, regardless of whether it is focused.
 * `realtime` means the timer is counting even if the window is not visible.
 */
type TimerMode = 'active' | 'realtime';

/**
 * `always` means the callback is executed even if the window is not visible.
 * `focused` means the callback is executed only if the window is focused.
 * `visible` means the callback is executed if the window is visible, regardless of whether it is focused.
 */
type ExecutionPolicy = 'always' | 'focused' | 'visible';

interface TimerOptions {
  mode?: TimerMode
  executionPolicy?: ExecutionPolicy
  signal?: AbortSignal
}

interface Timer {
  id: number
  callback: TimerCallback
  delay: number
  remaining: number
  repeat: boolean
  mode: TimerMode
  executionPolicy: ExecutionPolicy
  signal?: AbortSignal | null | undefined
}

interface TimerManagerOptions {
  max_delta_ms?: number
}

/**
 * Class to manage custom timers that are counted only if the page is visible/active.
 */
export class TimeManager {
  private visible = !document.hidden;
  private focused = document.hasFocus();
  private readonly timers = new Map<number, Timer>();
  private next_id = 1;
  private raf_id: number | null = null;
  private last_timestamp = 0;
  private readonly max_delta_ms: number;
  /**
   * Handling each animation frame.
   * @param timestamp - Current timestamp value.
   */
  private readonly handle_frame = (timestamp: number): void => {
    const raw_delta = timestamp - this.last_timestamp;
    this.last_timestamp = timestamp;
    const delta = Math.min(raw_delta, this.max_delta_ms);
    this.updateTimers(delta);
    if (this.timers.size > 0) {
      this.raf_id = requestAnimationFrame(this.handle_frame);
    } else {
      this.raf_id = null;
    }
  };

  /**
   * Create the Time Manager.
   * @param options - Time Manager options.
   */
  public constructor(options: TimerManagerOptions = {}) {
    this.max_delta_ms = options.max_delta_ms ?? 100;
    document.addEventListener('visibilitychange', () => {
      this.visibilityChange();
    });
    window.addEventListener('focus', () => {
      this.visibilityChange();
    });
    window.addEventListener('blur', () => {
      this.visibilityChange();
    });
  }

  /**
   * Change visibility attributes.
   */
  private visibilityChange(): void {
    this.visible = !document.hidden;
    this.focused = document.hasFocus();
  }

  /**
   * Sets a timer which executes a function or specified piece of code once the timer expires.
   * @param callback - A function to be executed after the timer expires.
   * @param delay - A non-negative integer indicating how long the timer should wait before the specified function or code is executed, in milliseconds. Defaults to 0 if not specified.
   * @param options - Timer options.
   */
  public setTimeout(callback: TimerCallback, delay = 0, options: TimerOptions = {}): number {
    return this.createTimer(callback, delay, false, options);
  }

  /**
   * Repeatedly calls a function or executes a code snippet, with a fixed time delay between each call.
   * @param callback - A function to be executed after every `delay` millisecond. The first execution happens after `delay` milliseconds.
   * @param delay - The delay time between executions of the specified function or code, in milliseconds. Defaults to 0 if not specified.
   * @param options - Time options.
   */
  public setInterval(callback: TimerCallback, delay = 0, options: TimerOptions = {}): number {
    return this.createTimer(callback, delay, true, options);
  }

  /**
   * Cancels a timeout previously established by a call to `setTimeout()`. If the parameter provided does not identify a previously established action, this method does nothing.
   * @param timeout - The identifier of the repeated action you want to cancel. This ID was returned by the corresponding call to `setTimeout()`.
   */
  public clearTimeout(timeout: number): void {
    this.clear(timeout);
  }

  /**
   * Cancels a timed, repeating action, which was previously established by a call to `setInterval()`. If the parameter provided does not identify a previously established action, this method does nothing.
   * @param timeout - The identifier of the repeated action you want to cancel. This ID was returned by the corresponding call to `setInterval()`.
   */
  public clearInterval(timeout: number): void {
    this.clear(timeout);
  }

  /**
   * Removes a timer regardless of whether it was created by `setTimeout()` or `setInterval()`.
   */
  private clear(id: number): void {
    this.timers.delete(id);
    this.stopIfIdle();
  }

  // noinspection JSUnusedGlobalSymbols This may be used right now, but it's better to have it prepared
  /**
   * Stops all timers and permanently shuts down the manager.
   */
  public destroy(): void {
    this.stop();
    this.timers.clear();
  }

  /**
   * Creates and registers an internal timer.
   * @param callback - Callback to run.
   * @param delay - How long to wait.
   * @param repeat - Whether to repeat the timer.
   * @param options - Timer options.
   * @throws {TypeError | RangeError}
   */
  private createTimer(callback: TimerCallback, delay: number, repeat: boolean, options: TimerOptions): number {
    if (!Number.isFinite(delay)) {
      throw new TypeError('Delay must be finite.');
    }
    if (delay < 0) {
      throw new RangeError('Delay cannot be negative.');
    }
    const signal = options.signal;
    if (signal?.aborted === true) {
      return -1;
    }
    const id = this.next_id;
    this.next_id += 1;
    const timer: Timer = {
      id,
      callback,
      delay,
      remaining: delay,
      repeat,
      mode: options.mode ?? 'active',
      executionPolicy:
        options.executionPolicy ?? 'always',
      signal,
    };
    this.timers.set(id, timer);
    signal?.addEventListener(
      'abort',
      () => {
        this.clear(id);
      },
      {
        once: true,
      },
    );
    this.startIfNeeded();
    return id;
  }

  /**
   * Starts the RAF loop if it is not already running.
   */
  private startIfNeeded(): void {
    if (this.raf_id !== null) {
      return;
    }
    this.last_timestamp = performance.now();
    this.raf_id = requestAnimationFrame(this.handle_frame);
  }

  /**
   * Stops the RAF loop.
   */
  private stop(): void {
    if (this.raf_id === null) {
      return;
    }
    cancelAnimationFrame(this.raf_id);
    this.raf_id = null;
  }

  /**
   * Stops the RAF loop if there are no active timers.
   */
  private stopIfIdle(): void {
    if (this.timers.size > 0) {
      return;
    }
    this.stop();
  }

  /**
   * Advances timers and executes eligible callbacks.
   */
  private updateTimers(delta: number): void {
    for (const timer of this.timers.values()) {
      if (
        timer.signal?.aborted === true
      ) {
        this.clear(timer.id);
        continue;
      }
      const can_execute = this.canExecute(timer.executionPolicy, this.visible, this.focused);
      if (timer.mode === 'realtime' ? true : can_execute) {
        timer.remaining -= delta;
      }
      if (timer.remaining > 0) {
        continue;
      }
      if (!can_execute) {
        continue;
      }
      try {
        timer.callback();
      } catch (error) {
        // Can't use Snackbar, since Snackbar is dependent on TimeManager, so failing back to console.
        // eslint-disable-next-line no-console
        console.error('TimeManager callback failed:', error);
      }
      if (timer.repeat) {
        timer.remaining += timer.delay;
        if (timer.remaining <= 0) {
          timer.remaining = timer.delay;
        }
      } else {
        this.clear(timer.id);
      }
    }
  }

  /**
   * Determines whether a callback is currently allowed to execute.
   */
  private canExecute(policy: ExecutionPolicy, visible: boolean, focused: boolean): boolean {
    switch (policy) {
      case 'always':
        return true;
      case 'visible':
        return visible;
      case 'focused':
        return visible && focused;
      default:
        return false;
    }
  }
}
