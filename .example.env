#GID and UID used for users on containers
HOST_UID=1000
HOST_GID=1000

#Password for 7Z backup files for extra security of data at rest
MARIADB_BACKUP_PASSWORD=

#CrowdSec bouncers keys
CROWDSEC_CADDY_KEY=
CROWDSEC_IPTABLES_KEY=
#CrowdSec console enrollment key
CROWDSEC_ENROLL_KEY=
#CrowdSec database password
CROWDSEC_PASSWORD=

#GeoIP2 details
GEOIP_ACCOUNT=
GEOIP_LICENSE=

#Database connection settings (besides port in MariaDB section) used by PHP
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=simbiatr_simbiat
DATABASE_SOCKET=/run/mysqld/mysqld.sock
DATABASE_VERSION=

#Proton SMTP setting
ADMIN_EMAIL=admin@example.com
PROTON_USER=
PROTON_PASSWORD=
PROTON_HOST=
PROTON_PORT=

#Passphrase for two-way encryption
ENCRYPTION_PASSPHRASE=

#phpMyAdmin port to expose to host
PHPMYADMIN_PORT=12345
#phpMyAdmin control user password
PHPMYADMIN_PASSWORD=

#Remote server and host to sync data from as part of backup strategy
RSYNC_REMOTE_HOST=
RSYNC_REMOTE_USER=
#Path to project directory on DEV
RSYNC_DEV_DIR=
#Path to project directory on PROD
RSYNC_PROD_DIR=
#Path to copy database backups to
RSYNC_BACKUP_DIR=
#Directory to where the main project files will be mirrored on source
RSYNC_MIRROR_DIR=

###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=dfgjdgfjghjfg
APP_SHARE_DIR=var/share
APP_DEBUG=0
###< symfony/framework-bundle ###

###> symfony/mailer ###
MAILER_DSN="smtp://${PROTON_USER}:${PROTON_PASSWORD}@${PROTON_HOST}:${PROTON_PORT}"
###< symfony/mailer ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=https://example.com
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###
