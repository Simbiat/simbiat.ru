        "ext-pcntl": "*",
        "ext-pcov": "*",
        "ext-xdebug": "*",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "escapestudios/symfony2-coding-standard": "^3.18",
        "phpcompatibility/php-compatibility": "^10@dev",
        "phpcsstandards/phpcsextra": "^1.5.1",
        "phpstan/phpstan": "^2.2.15",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpstan/phpstan-symfony": "^2.0.20",
        "phpunit/phpunit": "^13.3.4",
        "psalm/plugin-phpunit": "^0",
        "psalm/plugin-symfony": "^5.3",
        "roave/security-advisories": "dev-latest",
        "slevomat/coding-standard": "^8.31.1",
        "squizlabs/php_codesniffer": "^4.0.4",
        "symfony/browser-kit": "^8.1.5",
        "symfony/css-selector": "^8.1.6",
        "symfony/debug-bundle": "^8.1",
        "symfony/maker-bundle": "^1.68",
        "symfony/stopwatch": "^8.1",
        "symfony/web-profiler-bundle": "^8.1.7",
        "vimeo/psalm": "^6.18.0",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpmd/phpmd": "^3.0.0@dev",
        "pdepend/pdepend": "^3.0.0@dev",
        "vincentlanglet/twig-cs-fixer": "^4.1.1",
        "phildaiguille/twig-a11y-rules": "^0.9",
        "rector/rector": "^2.6.7",
        "symplify/phpstan-rules": "^14.17",
        "shipmonk/composer-dependency-analyser": "^1.8.4"
    },
    "scripts": {
        "analyze-dependencies": "composer-dependency-analyser --composer-json /app/composer.json --config /app/config/composer-dependency-analyser.php",
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd",
            "app:db:ddl": "symfony-cmd"
        },
        "cache:clear_dev": "bin/console cache:clear --env=dev",
        "php-cs-fixer": "php-cs-fixer fix --dry-run --config=/app/config/php-cs-fixer.php --using-cache=yes --cache-file=/app/data/temp/.php-cs-fixer.cache --verbose --allow-risky=yes --path-mode=intersection",
        "phpcbf": "phpcbf --standard=/app/config/phpcs.xml",
        "phpcs": "phpcs --standard=/app/config/phpcs.xml -s",
        "phpmd": "phpmd analyze --cache --cache-file=/app/data/temp/.phpmd.result-cache.php --cache-strategy=content --ruleset=/app/config/phpmd.xml --threads=4 --jetbrains=simbiat.eu",
        "phpstan": "phpstan analyse -c /app/config/phpstan.neon --memory-limit 1G",
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "psalm": "psalm --config=/app/config/psalm.xml --memory-limit=1G",
        "rector": "rector --config=/app/config/rector.php --dry-run",
        "twig-cs": "twig-cs-fixer lint --config=/app/config/twig-cs-fixer.php",
        "twig-cs-inspection": "twig-cs-fixer lint --config=/app/config/twig-cs-fixer.php --report=github"
    },
    "version": "1.0.0"
}
