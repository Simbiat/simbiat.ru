{
    "name": "simbiat/simbiat.ru",
    "description": "Package for simbiat.eu",
    "prefer-stable": true,
    "version": "1.0.0",
    "minimum-stability": "dev",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Dmitrii Kustov",
            "email": "support@simbiat.eu",
            "homepage": "https://www.simbiat.eu",
            "role": "Developer"
        }
    ],
    "_comment": [
        "ext-bcmath and ext-gmp are used as suggestions from a bunch of dependencies for faster/better processing (at least geoip2/geoip2)",
        "ext-yaml is used as suggestion for matomo/device-detector",
        "ext-maxminddb is used to speed-up geoip2/geoip2",
        "ext-pcntl and ext-xdebug are used by PHPUnit",
        "below suggestions should be ignored:",
        "paragonie/random-lib - since ext-uuid is being used",
        "maxmind-db/reader-ext - since ext-maxminddb is being used",
        "jeremykendall/php-domain-parser - since does not seem to be used by the library",
        "league/uri-polyfill - since using modern PHP",
        "league/uri-components - since used only for tests",
        "rowbot/url - not used by the library",
        "ext-pcoc - since ext-xdebug is used",
        "weirdan/doctrine-psalm-plugin - since not using Doctrine"
    ],
    "require": {
        "php": "^8.5",
        "matomo/device-detector": "^6",
        "symfony/html-sanitizer": "^8",
        "symfony/mailer": "^8",
        "symfony/twig-bundle": "^8",
        "symfony/cache": "^8",
        "symfony/dotenv": "^8",
        "twig/twig": "^3",
        "twig/extra-bundle": "^3",
        "twig/cssinliner-extra": "^3",
        "geoip2/geoip2": "^3",
        "tinymce/tinymce": "^8",
        "tinify/tinify": "^1",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-apcu": "*",
        "ext-zlib": "*",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-openssl": "*",
        "ext-gd": "*",
        "ext-brotli": "*",
        "ext-zstd": "*",
        "ext-bcmath": "*",
        "ext-gmp": "*",
        "ext-maxminddb": "*",
        "ext-yaml": "*",
        "ext-uuid": "*"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "ext-pcntl": "*",
        "ext-xdebug": "*",
        "ext-igbinary": "*"
    },
    "scripts": {
        "php-cs-fixer": "/root/.composer/vendor/bin/php-cs-fixer check --config=/usr/local/etc/php/.php-cs-fixer.php --using-cache=yes --allow-risky=yes --path-mode=intersection",
        "phpstan": "/root/.composer/vendor/bin/phpstan analyse -c /usr/local/etc/php/phpstan.neon --memory-limit 1G",
        "psalm": "/root/.composer/vendor/bin/psalm --config=/usr/local/etc/php/psalm.xml --memory-limit=1G"
    },
    "autoload": {
        "psr-4": {
            "App\\": "./src"
        },
        "classmap": [
            "./packages"
        ]
    },
    "config": {
        "sort-packages": true,
        "store-auths": true,
        "preferred-install": "source",
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "htaccess-protect": true,
        "platform-check": true,
        "process-timeout": 900
    }
}