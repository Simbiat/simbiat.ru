{
    "_comment": [
        "\"cache:clear\": \"symfony-cmd\" was replaced by a custom script that ensures that Xdebug is disabled when it's run, because otherwise it takes too long",
        "",
        "Extras installed as per recommendations:",
        "ext-bcmath and ext-gmp are used as suggestions from a bunch of dependencies for faster/better processing (at least geoip2/geoip2)",
        "ext-yaml is used as suggestion for matomo/device-detector",
        "ext-maxminddb is used to speed-up geoip2/geoip2",
        "ext-pcntl and ext-xdebug are used by PHPUnit",
        "ext-pcov is recommended for line coverage in PHPUnit",
        "",
        "below suggestions should be ignored:",
        "league/uri suggests:",
        "jeremykendall/php-domain-parser - since does not seem to be used by the library",
        "league/uri-components - since used only for tests",
        "league/uri-polyfill - since using modern PHP",
        "rowbot/url - not used by the library",
        "",
        "maxmind-db/reader suggests:",
        "maxmind-db/reader-ext - since ext-maxminddb is being used",
        "",
        "monolog/monolog suggests:",
        "aws/aws-sdk-php, since not using AWS",
        "doctrine/couchdb, since not using CouchDB",
        "elasticsearch/elasticsearch, since not using Elastic Search",
        "ext-amqp, since not using AMQP",
        "ext-mongodb, since not using MongoDB",
        "ext-sockets, since not using Syslog",
        "graylog2/gelf-php, since not using GrayLog2",
        "mongodb/mongodb, since not using MongoDB",
        "php-amqplib/php-amqplib, since not using AMQP",
        "rollbar/rollbar, since not using Rollbar",
        "ruflin/elastica, since not using Elastic Search",
        "",
        "paragonie/random-lib - since ext-uuid is being used",
        "ext-pcoc - since ext-xdebug is used",
        "",
        "psalm/plugin-symfony suggests:",
        "weirdan/doctrine-psalm-plugin - since not using Doctrine",
        "",
        "symfony/polyfill-deepclone suggests:",
        "ext-deepclone, since not using the library, as far as I know (not directly, at least). May be required in future for VarExporter",
        "",
        "psr/link suggests:",
        "fig/link-util, since not using the library, as far as I know (not directly, at least)"
    ],
    "authors": [
        {
            "name": "Dmitrii Kustov",
            "email": "support@simbiat.eu",
            "homepage": "https://www.simbiat.eu",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "./src"
        },
        "classmap": [
            "./config"
        ]
    },
    "config": {
        "sort-packages": true,
        "store-auths": true,
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "htaccess-protect": true,
        "platform-check": true,
        "process-timeout": 900,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "description": "Package for simbiat.eu",
    "extra": {
        "qa-runner": {
            "check": {
                "Simbiat\\QARunner\\Adapters\\CodeSniffer": "@phpcs",
                "Simbiat\\QARunner\\Adapters\\CSFixer": "@php-cs-fixer",
                "Simbiat\\QARunner\\Adapters\\Stan": "@phpstan",
                "Simbiat\\QARunner\\Adapters\\Psalm": "@psalm",
                "Simbiat\\QARunner\\Adapters\\MessDetector": "@phpmd",
                "Simbiat\\QARunner\\Adapters\\Rector": "@rector",
                "Simbiat\\QARunner\\Adapters\\TwigCS": "@twig-cs"
            },
            "diff": {
                "Simbiat\\QARunner\\Adapters\\CodeSniffer": "@phpcs",
                "Simbiat\\QARunner\\Adapters\\CSFixer": "@php-cs-fixer",
                "Simbiat\\QARunner\\Adapters\\Psalm": "@psalter",
                "Simbiat\\QARunner\\Adapters\\Rector": "@rector"
            },
            "fix": {
                "Simbiat\\QARunner\\Adapters\\CodeSniffer": "@phpcbf",
                "Simbiat\\QARunner\\Adapters\\CSFixer": "@php-cs-fixer",
                "Simbiat\\QARunner\\Adapters\\Psalm": "@psalter",
                "Simbiat\\QARunner\\Adapters\\Rector": "@rector"
            }
        },
        "symfony": {
            "allow-contrib": false,
            "require": "8.*"
        }
    },
