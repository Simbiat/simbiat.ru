    "repositories": [
        {
            "type": "path",
            "url": "/app/packages/{*,*/*}",
            "options": {
                "versions": {
                    "simbiat/arrayhelpers": "4.2",
                    "simbiat/cron": "2.4",
                    "simbiat/db-binder": "1.1",
                    "simbiat/db-installer": "1.1",
                    "simbiat/db-manager": "1.1",
                    "simbiat/db-query": "1.1",
                    "simbiat/http20": "2.3",
                    "simbiat/sand-clock": "2.5",
                    "simbiat/sse": "1.2",
                    "simbiat/stringhelpers": "2.1"
                }
            }
        }
    ],
    "scripts": {
        "analyze-dependencies": "composer-dependency-analyser --composer-json /app/composer.json --config /app/config/quality/composer-dependency-analyser.php",
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd",
            "app:db:ddl": "symfony-cmd"
        },
        "cache:clear_dev": "bin/console cache:clear --env=dev",
        "php-cs-fixer": "php-cs-fixer fix --dry-run --config=/app/config/quality/php-cs-fixer.php --using-cache=yes --cache-file=/app/data/temp/.php-cs-fixer.cache --verbose --allow-risky=yes --path-mode=intersection",
        "phpcbf": "phpcbf --standard=/app/config/quality/phpcs.xml",
        "phpcs": "phpcs --standard=/app/config/quality/phpcs.xml -s",
        "phpmd": "phpmd analyze --cache --cache-file=/app/data/temp/.phpmd.result-cache.php --cache-strategy=content --ruleset=/app/config/quality/phpmd.yaml --threads=4 --jetbrains=simbiat.eu",
        "phpstan": "phpstan analyse --configuration=/app/config/quality/phpstan.neon --memory-limit=1G",
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "psalter": "psalter --config=/app/config/quality/psalm.xml --memory-limit=1G --show-info=true",
        "psalm": "psalm --config=/app/config/quality/psalm.xml --memory-limit=1G --show-info=true",
        "rector": "rector --config=/app/config/quality/rector.php --dry-run",
        "twig-cs": "twig-cs-fixer lint --config=/app/config/quality/twig-cs-fixer.php"
    },
    "version": "1.0.0"
}
